{
  "manifest_version": 3,
  "name": "Deep Pick",
  "version": "0.1.0",
  "description": "Preview and save images under the cursor with Ctrl+Shift.",
  "permissions": [
    "clipboardWrite",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/main.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "src/shared/constants.js",
        "src/shared/messages.js",
        "src/shared/settings.js",
        "src/shared/url.js",
        "src/content/download-client.js",
        "src/content/event-utils.js",
        "src/content/dom-utils.js",
        "src/content/image-candidates.js",
        "src/content/overlay.js",
        "src/content/controller.js",
        "src/content/main.js"
      ]
    }
  ]
}